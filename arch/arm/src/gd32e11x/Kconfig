# Peripheral Selection

config GD32E11X_ADC0
	bool "ADC0"
	default n
	depends on GD32E11X_HAVE_ADC0
	select GD32E11X_ADC
	select GD32E11X_HAVE_ADC0_DMA if GD32E11X_DMA0

config GD32E11X_ADC1
	bool "ADC1"
	default n
	depends on GD32E11X_HAVE_ADC1
	select GD32E11X_ADC

config GD32E11X_ADC0_DMA
	bool "ADC0 DMA"
	default n
	depends on GD32E11X_ADC0 && GD32E11X_HAVE_ADC0_DMA
	---help---
		Use DMA to transfer ADC0 conversion results.
		ADC0 uses DMA0 Channel 0.

config GD32E11X_ADC0_SCAN
	bool "ADC0 scan mode"
	default n
	depends on GD32E11X_ADC0
	---help---
		Enable scan mode for ADC0. In scan mode, all channels in the
		regular group conversion sequence are converted automatically.

config GD32E11X_ADC1_SCAN
	bool "ADC1 scan mode"
	default n
	depends on GD32E11X_ADC1
	---help---
		Enable scan mode for ADC1. In scan mode, all channels in the
		regular group conversion sequence are converted automatically.

config GD32E11X_CAN0
	bool "CAN0"
	select CAN
	select GD32E11X_CAN
	default n
	depends on GD32E11X_HAVE_CAN0

config GD32E11X_CAN1
	bool "CAN1"
	select CAN
	select GD32E11X_CAN
	default n
	depends on GD32E11X_HAVE_CAN1

config GD32E11X_BKP
	bool "BKP"
	default n
	---help---
		Enable access to the backup domain registers used by RTC state
		retention.

config GD32E11X_PMU
	bool "PMU"
	default n
	---help---
		Enable the power control block. RTC backup-domain writes depend on
		this peripheral.

config GD32E11X_RTC
	bool "RTC"
	default n
	select RTC
	select GD32E11X_BKP
	select GD32E11X_PMU
	---help---
		Enable the GD32E11x counter RTC driver.

config GD32E11X_DAC0
	bool "DAC0"
	default n
	depends on GD32E11X_HAVE_DAC
	select GD32E11X_DAC
	select DAC
	select ANALOG

config GD32E11X_DAC1
	bool "DAC1"
	default n
	depends on GD32E11X_HAVE_DAC
	select GD32E11X_DAC
	select DAC
	select ANALOG

config GD32E11X_CRC
	bool "CRC"
	default n
	---help---
		Enable CRC (Cyclic Redundancy Check) calculation unit support.
		The CRC unit uses a fixed polynomial (0x4C11DB7) which is the same
		as Ethernet CRC-32.

config GD32E11X_DMA0
	bool "DMA0"
	default n
	select GD32E11X_DMA
	select ARCH_DMA

config GD32E11X_DMA1
	bool "DMA1"
	default n
	select GD32E11X_DMA
	select ARCH_DMA

