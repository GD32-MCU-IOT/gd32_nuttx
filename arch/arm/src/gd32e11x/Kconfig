	bool
	default n
	select ARCH_ARMV7M
	select ARCH_CORTEXM4
	select ARCH_HAVE_FPU
	select ARCH_HAVE_MPU
	select ARCH_HAVE_RESET_H
	select ARCH_HAVE_SYSTICK_IRQ
	select GD32E11X_HAVE_DMA0
	select GD32E11X_HAVE_DMA1
	select GD32E11X_HAVE_EXMC
