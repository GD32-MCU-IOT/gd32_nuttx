include armv7-m/Make.defs

# Required GD32H7 files

CHIP_CSRCS  = gd32h73x_75x_allocateheap.c gd32h73x_75x_start.c gd32h73x_75x_rcu.c
CHIP_CSRCS += gd32h73x_75x_gpio.c gd32h73x_75x_lowputc.c gd32h73x_75x_irq.c

# Optional GD32H7 files

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += gd32h73x_75x_timerisr.c
else
CHIP_CSRCS += gd32h73x_75x_tickless.c
endif

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CHIP_CSRCS += gd32h73x_75x_idle.c
endif

ifeq ($(CONFIG_GD32H73X_75X_SERIALDRIVER),y)
CHIP_CSRCS += gd32h73x_75x_serial.c
endif

ifeq ($(CONFIG_GD32H73X_75X_EXTI),y)
CHIP_CSRCS += gd32h73x_75x_exti.c
endif

ifeq ($(CONFIG_GD32H73X_75X_DMA),y)
CHIP_CSRCS += gd32h73x_75x_dma.c
endif

ifeq ($(CONFIG_GD32H73X_75X_SPI),y)
CHIP_CSRCS += gd32h73x_75x_spi.c
endif

ifeq ($(CONFIG_GD32H73X_75X_I2C),y)
CHIP_CSRCS += gd32h73x_75x_i2c.c
endif

ifeq ($(CONFIG_BUILD_PROTECTED),y)
CHIP_CSRCS += gd32h73x_75x_userspace.c
CHIP_CSRCS += gd32h73x_75x_mpuinit.c
endif
